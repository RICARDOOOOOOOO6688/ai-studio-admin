# =============================================================================
# Copy to .env and fill in real values. NEVER commit the real .env.
# The Admin app shares the SAME Supabase project as Project Navigator.
# =============================================================================

# --- Supabase (browser-visible) ---------------------------------------------
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Supabase (server-side) --------------------------------------------------
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# SECRET. Server-only. Required for the Auth admin API (user list) and
# cross-user reads (usage). Never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Deployment info (shown on the dashboard "Cloudflare" status card) --------
# On Cloudflare Workers, bind `version_metadata` as CF_VERSION_METADATA to get
# {id, tag, timestamp} automatically. Otherwise set these at build/deploy time.
DEPLOY_VERSION=
DEPLOY_TIME=
